# --- Model Configuration ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Paths ---
DATA_DIR=data

# --- Retrieval Tuning ---
# Minimum similarity score for dense-only mode (0.0 = no filtering, recommended for benchmarks)
MIN_RELEVANCE_SCORE=0.0

# Number of candidates retrieved from each retriever before fusion
CANDIDATE_K=20
